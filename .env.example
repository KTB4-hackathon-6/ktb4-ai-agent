# AWS / S3 configuration
AWS_REGION=ap-northeast-2
S3_BUCKET_NAME=hackathon6-s3
S3_ORIGINALS_PREFIX=originals/
S3_RESULTS_PREFIX=results/
S3_MODELS_PREFIX=models/
S3_PRESIGNED_EXPIRES_SECONDS=600

# Never commit AWS access keys, database passwords, JWT secrets, or AI API keys.

# TLS certificate registration
ACME_EMAIL=admin@example.com

# OCR (Naver Clova OCR)
NAVER_OCR_INVOKE_URL=
NAVER_OCR_SECRET_KEY=

# RAG (Upstage solar embeddings)
UPSTAGE_API_KEY=
EMBEDDING_MODEL=solar-embedding-1-large

# Chat
DEEPSEEK_API_KEY=
CHAT_MODEL=deepseek-v4-flash

# Observability
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_PROJECT=ktb4-ai-agent
LANGSMITH_WORKSPACE_ID=
