# Copy to .env and fill in values. Never commit the real .env file.

# AWS / S3 (shared config, see root .env.example)
AWS_REGION=ap-northeast-2
S3_BUCKET_NAME=hackathon6-s3
S3_ORIGINALS_PREFIX=originals/
S3_RESULTS_PREFIX=results/
S3_MODELS_PREFIX=models/
S3_PRESIGNED_EXPIRES_SECONDS=600

# OCR (Naver Clova OCR — NCP 콘솔에서 도메인 생성 후 발급)
NAVER_OCR_INVOKE_URL=
NAVER_OCR_SECRET_KEY=

# RAG (embedding provider TBD)
EMBEDDING_PROVIDER_API_KEY=

# Chat
DEEPSEEK_API_KEY=
CHAT_MODEL=deepseek-v4-flash
